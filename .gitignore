# ==========================================
# DevSecOps Comprehensive .gitignore
# ==========================================

# 1. Environment & Secrets (Shift-Left Security)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials.json
LOCAL_ACCESS_GUIDE.md
local_*.md

# 2. Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Build & Compiled Artifacts
dist/
build/
out/
.next/
.cache/
coverage/
*.lcov

# 4. Uploads & Ephemeral User Data
backend/uploads/*
!backend/uploads/.gitkeep

# 5. Infrastructure as Code (Terraform)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# 6. Kubernetes & Cloud Configs
*.kubeconfig
kubeconfig

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
